# ── MAIN / LOADER BOT (bot.py) ───────────────────────────────────────────────
# Handles license registration and the loader /verify + /macro_event API.
# Copy to /opt/voidbots/env/main.env and fill in the real values.

DISCORD_TOKEN=CHANGE_ME_MAIN_BOT_TOKEN

# Shared database - ALL four bots must point at this same file.
DB_PATH=/opt/voidbots/data/keylock.db

# Health/loader API port (must be unique per bot on this VPS).
PORT=8080

GUILD_ID=CHANGE_ME
ADMIN_ROLE_ID=CHANGE_ME
VERIFIED_ROLE_ID=CHANGE_ME
BANNED_ROLE_ID=CHANGE_ME
FAC_PAID_ROLE_ID=CHANGE_ME
HWID_PAID_ROLE_ID=CHANGE_ME
LOG_CHANNEL_ID=CHANGE_ME
LOADER_LOG_CHANNEL_ID=CHANGE_ME

KEY_PREFIX=KL
MAX_HWID_RESETS=3
