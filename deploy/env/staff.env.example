# ── STAFF BOT (staff_bot.py) ─────────────────────────────────────────────────
# Admin/staff commands: keygen, lookup, bans, changelogs, setup.
# Copy to /opt/voidbots/env/staff.env and fill in the real values.

DISCORD_TOKEN=CHANGE_ME_STAFF_BOT_TOKEN

# Shared database - same file as every other bot.
DB_PATH=/opt/voidbots/data/keylock.db

# Unique health/API port on this VPS.
PORT=8082

# Shared secret - must MATCH customer.env and void.env exactly.
INTERNAL_API_KEY=CHANGE_ME_SHARED_SECRET

# Customer bot API, reached over localhost. This is what makes /keygen
# deliver_to actually DM the key (the customer bot sends it).
CUSTOMER_BOT_URL=http://127.0.0.1:8081

GUILD_ID=CHANGE_ME
MAIN_GUILD_ID=CHANGE_ME
VOID_GUILD_ID=CHANGE_ME
ADMIN_ROLE_ID=CHANGE_ME
VERIFIED_ROLE_ID=CHANGE_ME
BANNED_ROLE_ID=CHANGE_ME
FAC_PAID_ROLE_ID=CHANGE_ME
HWID_PAID_ROLE_ID=CHANGE_ME
TICKET_CATEGORY_ID=CHANGE_ME
LOG_CHANNEL_ID=CHANGE_ME
LOADER_LOG_CHANNEL_ID=CHANGE_ME

LOG_WEBHOOK_URL=
CUSTOMER_CHANGELOG_WEBHOOK=
VOID_MAIN_CHANGELOG_WEBHOOK=

KEY_PREFIX=KL
MAX_HWID_RESETS=3
