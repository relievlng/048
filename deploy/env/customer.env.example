# ── CUSTOMER BOT (customer_bot.py) ───────────────────────────────────────────
# Customer-facing: tickets, verification, HWID resets, key delivery DMs.
# Copy to /opt/voidbots/env/customer.env and fill in the real values.

DISCORD_TOKEN=CHANGE_ME_CUSTOMER_BOT_TOKEN

# Shared database - same file as every other bot.
DB_PATH=/opt/voidbots/data/keylock.db

# Unique health/API port on this VPS. Staff bot calls this for key delivery.
PORT=8081

# Shared secret - must be IDENTICAL on staff.env and void.env.
INTERNAL_API_KEY=CHANGE_ME_SHARED_SECRET

# Void bot API, reached over localhost on this same box.
VOID_BOT_URL=http://127.0.0.1:8083

GUILD_ID=CHANGE_ME
ADMIN_ROLE_ID=CHANGE_ME
MANAGEMENT_ROLE_ID=CHANGE_ME
VERIFIED_ROLE_ID=CHANGE_ME
RESETUP_NEEDED_ROLE_ID=CHANGE_ME
RESETUP_NEEDED_PAYMENT_ROLE_ID=CHANGE_ME
SETUP_PINGS_ROLE_ID=CHANGE_ME

RULES_CHANNEL_ID=CHANGE_ME
VERIFY_CHANNEL_ID=CHANGE_ME
HWID_CHANNEL_ID=CHANGE_ME
TICKET_CHANNEL_ID=CHANGE_ME
SETUP_ALERTS_CHANNEL_ID=CHANGE_ME
TICKET_CATEGORY_ID=CHANGE_ME

# Ticket-type category IDs (auto-created on first use if left blank).
TICKET_CAT_SUPPORT=
TICKET_CAT_SETUP=
TICKET_CAT_PURCHASE=
TICKET_CAT_MANAGEMENT=
TICKET_CAT_HWID_RESET=

# Per-channel log webhooks (staff bot's /setup can also generate these).
WEBHOOK_CUSTOMER_VERIFICATIONS=
WEBHOOK_CUSTOMER_HWID_RESETS=
WEBHOOK_CUSTOMER_TICKETS_OPENED=
WEBHOOK_CUSTOMER_TICKETS_CLOSED=
WEBHOOK_CUSTOMER_TICKET_TRANSCRIPTS=
WEBHOOK_CUSTOMER_KEY_GENERATED=
WEBHOOK_CUSTOMER_BANS=
LOG_WEBHOOK_URL=

LOGO_URL=
KEY_PREFIX=KL
MAX_HWID_RESETS=3

# EMOJI_* variables are optional: the bot auto-uploads them from the
# emojis/ folder on first boot, so leave them unset.
