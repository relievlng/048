# ── VOID BOT (void_bot.py) ───────────────────────────────────────────────────
# Sales/storefront: product panels, payment tickets, verify panel, changelogs.
# Copy to /opt/voidbots/env/void.env and fill in the real values.

VOID_TOKEN=CHANGE_ME_VOID_BOT_TOKEN

# Shared database - same file as every other bot.
DB_PATH=/opt/voidbots/data/keylock.db

# Unique health/API port on this VPS (customer bot calls this).
PORT=8083

# Shared secret - must MATCH customer.env and staff.env exactly.
INTERNAL_API_KEY=CHANGE_ME_SHARED_SECRET

VOID_GUILD_ID=CHANGE_ME
VOID_CUSTOMER_GUILD_ID=CHANGE_ME
VOID_ADMIN_ROLE_ID=CHANGE_ME
VOID_STAFF_ROLE_ID=CHANGE_ME
VOID_VERIFIED_ROLE_ID=CHANGE_ME
VOID_TICKET_CATEGORY_ID=CHANGE_ME

VOID_TICKET_CAT_SUPPORT=
VOID_TICKET_CAT_PURCHASE=
VOID_TICKET_CAT_MANAGEMENT=
VOID_TICKET_CAT_MEDIA=

VOID_BRAND_NAME=Void
VOID_KEY_PREFIX=VD
VOID_LOGO_URL=
VOID_PUBLIC_IMAGE_URL=
VOID_PRIVATE_IMAGE_URL=

# Cheat/loader event webhooks.
WEBHOOK_CHEAT_LOADER_EVENTS=
WEBHOOK_CHEAT_KEY_EVENTS=
WEBHOOK_CHEAT_HWID_FLAGS=
