[Unit]
Description=Void Main / Loader Bot (bot.py)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=voidbots
WorkingDirectory=/opt/voidbots
EnvironmentFile=/opt/voidbots/env/main.env
ExecStart=/opt/voidbots/venv/bin/python /opt/voidbots/bot.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
